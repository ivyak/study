              "type": "object",
              "properties": {
                "task": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url",
                    "path",
                    "kind"
                  ],
                  "additionalProperties": false
                },
                "error": {
                  "type": "string"
                }
