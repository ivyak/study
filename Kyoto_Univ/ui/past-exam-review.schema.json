              "kuwiki",
              "kuinfo2020",
              "ku1025",
              "past-exam-drive"
            ]
          },
          "pages": {
            "type": "integer"
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "path",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "errors": {
            "type": "array",
